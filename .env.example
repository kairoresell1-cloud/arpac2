# --- Obbligatorie ---
GROQ_API_KEY=
# Generato automaticamente per te (32 byte casuali, pronto all'uso).
# Puoi tenerlo così com'è oppure rigenerarlo con: openssl rand -hex 32
SESSION_SECRET=a1487af0896d0c53ea688795c0620dcd0169b45b20c501b6c29a6b3db4d749bb

# Modello Groq da usare (default: openai/gpt-oss-120b, supporta reasoning hidden)
GROQ_MODEL=openai/gpt-oss-120b

# --- Modalità file-locale (default, nessuna variabile extra richiesta) ---
# Cartella dove viene salvato db.json. Su Railway punta al volume montato.
DATA_DIR=/data

# --- Modalità Supabase (opzionale, per multi-utente reale) ---
# Se valorizzate ENTRAMBE, l'app passa automaticamente in modalità Supabase.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
